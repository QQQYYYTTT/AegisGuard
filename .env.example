# AegisGuard 后端环境变量模板
#
# 使用方法：复制为项目根目录下的 .env（不要提交 .env 本身，已在 .gitignore 中忽略）：
#   cp .env.example .env          # macOS/Linux
#   Copy-Item .env.example .env   # Windows PowerShell
#
# 后端启动时会自动加载项目根目录的 .env（见 backend/internal/config/config.go），
# 未设置的变量会回退到代码里写死的默认值——那些默认值对开发环境是安全的占位符，
# 但下面标注为"必须覆盖"的几项如果在生产环境仍使用默认值，会造成真实的安全风险，
# 因此不能像其余配置项一样硬编码在 Go 代码里，只能通过环境变量在部署时注入。

# ============================================================================
# 密钥与凭据（⚠️ 必须覆盖，不能硬编码到代码或提交到仓库）
# ============================================================================

# RequireToken（SM2 签名令牌）使用的签名私钥，16 进制字符串。
# 留空时每次进程启动都会自动生成一个新的临时密钥对——这意味着重启后旧令牌全部失效，
# 且多副本部署时每个实例的签名互不可信。生产环境 / 多实例部署必须显式指定同一把私钥。
AEGIS_SIGNING_PRIVATE_KEY=

# 用户系统 JWT/Token 使用的签名密钥。默认值 aegisguard-dev-user-secret 只用于本地开发，
# 生产环境必须替换为随机生成的高强度密钥，否则任何人都可以伪造用户登录态。
AEGIS_USER_TOKEN_SECRET=aegisguard-dev-user-secret

# AI 助手（前端"智能助手"面板）调用的模型服务 API Key。真实密钥严禁提交到仓库或写死在代码里，
# 留空时助手功能不可用。
AEGIS_ASSISTANT_API_KEY=

# 网关代理凭据的环境变量覆盖项（优先级高于 backend/config/gateway.yaml，方便生产环境注入，
# 不写入 gateway.yaml 明文文件）。gateway.yaml 本身已在 .gitignore 中排除，见其同目录下的
# gateway.yaml.example 模板；这里的两个变量用于在容器化/CI 场景下不落盘明文配置文件。
# 留空则使用 gateway.yaml 中的值。
AEGIS_TARGET_URL=
AEGIS_LLM_API_KEY=

# ============================================================================
# AI 助手服务配置
# ============================================================================

# 助手服务的 OpenAI 兼容 API Base URL
AEGIS_ASSISTANT_API_BASE=https://api.siliconflow.cn/v1
# 助手使用的模型名
AEGIS_ASSISTANT_MODEL=Qwen/Qwen3.5-9B
# 可选：推理强度（部分模型支持），留空则不传该参数
AEGIS_ASSISTANT_REASONING_EFFORT=
# 可选：思考过程类型（部分模型支持），留空则不传该参数
AEGIS_ASSISTANT_THINKING_TYPE=

# LangGraph 演示后端地址（用于"实验结果"页面的对照实验，非核心链路）
LANGGRAPH_CHAT_URL=http://127.0.0.1:8765

# ============================================================================
# 服务基础配置
# ============================================================================

# 后端监听端口
PORT=8090
# 是否开启开发者模式（实验结果读取接口等仅供演示使用的路由）
# 生产环境建议设为 false
AEGIS_DEV_MODE=true
# 日志级别：debug | info | warn | error
AEGIS_LOG_LEVEL=debug
# 日志编码：console（开发，带颜色）| production（生产，JSON 结构化）
AEGIS_LOG_ENCODING=console

# 网关凭据配置文件路径（gateway_key / target_url / llm_api_key）
AEGIS_GATEWAY_CONFIG=backend/config/gateway.yaml

# ============================================================================
# 授权与策略
# ============================================================================

# RequireToken 校验模式：strict（无 Token 一律拒绝）| compat（放行但标记）| warn（放行并告警）
AEGIS_TOKEN_MODE=strict
# PolicyEngine 整体策略强度：目前仅用于展示/审计标注，不影响具体规则阈值
AEGIS_POLICY_MODE=balanced
# MessageGate 命中高危规则时的处置方式：block（直接阻断）| degrade/soft/sanitize（降级净化后放行）
AEGISGUARD_MESSAGE_BLOCK_MODE=block

# ============================================================================
# 审计存储
# ============================================================================

# 审计存储后端：sqlite | jsonl
AEGIS_AUDIT_STORAGE_MODE=sqlite
# SQLite 审计库路径（AEGIS_AUDIT_STORAGE_MODE=sqlite 时使用）
AEGIS_AUDIT_DB_PATH=backend/data/audit-store.db
# 是否开启 SQLite WAL 模式
AEGIS_SQLITE_WAL_MODE=true
# JSONL 审计文件路径（AEGIS_AUDIT_STORAGE_MODE=jsonl 时使用，或 sqlite 初始化失败时的兜底）
AEGIS_AUDIT_FILE=backend/data/audit-store.jsonl

# 用户系统 SQLite 数据库路径
AEGIS_USER_DB_PATH=backend/data/aegisguard-users.db

# ============================================================================
# Phase 1：上下文自适应规则动态切分（借鉴 DRIFT）
# ============================================================================

# 是否按工具名动态路由 ActionGate 规则子集；关闭时对每次调用做全量六类规则扫描
AEGIS_DYNAMIC_RULE_ROUTING=false

# ============================================================================
# Phase 2：工具调用拓扑校验（借鉴 IPIGuard · TDG）
# ============================================================================

AEGIS_TDG_ENABLED=false
# log-only（只记录违规不阻断）| enforce（刚性阻断）
AEGIS_TDG_MODE=log-only
# 单个 Trace 内允许出现的不同工具种类数上限
AEGIS_TDG_MAX_NODES=50
# 同一工具允许连续重复调用的次数上限
AEGIS_TDG_MAX_REPEAT=5
# 单个 Trace 拓扑在内存中的保留时间，Go duration 格式（如 30m、1h）
AEGIS_TDG_TTL=30m

# ============================================================================
# Phase 3：非侵入式流量溯源标记（借鉴 AuthGraph）
# ============================================================================

AEGIS_PROVENANCE_ENABLED=false
# log-only（只记录违规不阻断）| enforce（刚性阻断）
AEGIS_PROVENANCE_MODE=log-only

# ============================================================================
# Phase 4：工具回执三态纯化引擎（借鉴 Structured Purification）
# ============================================================================

AEGIS_PURIFICATION_ENABLED=false
# log-only（只记录三态分类结果不修改响应体）| enforce（真正应用白名单直通/黑名单抹除/隔离区剥离）
AEGIS_PURIFICATION_MODE=log-only

# ============================================================================
# 态势大屏：威胁地图目标网关所在地
# ============================================================================

# 大屏地图中央固定点（客户网关所在地），格式：城市名,经度,纬度
# 留空或格式错误时，程序会尝试根据服务器公网网卡 IP 自动推断；推断失败则回退广州。
# 需要把 ip2region.xdb 放到 backend/data/ip2region.xdb 才能真实定位，否则使用内置示例 IP 规则。
# AEGIS_THREAT_MAP_TARGET=广州,113.264,23.129

