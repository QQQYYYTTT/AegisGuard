{
  "name": "aegisguard",
  "version": "0.2.0",
  "private": true,
  "description": "AegisGuard experiment framework for native agent security evaluation and runtime control prototyping.",
  "scripts": {
    "start": "go run ./backend/cmd/server",
    "start:backend": "go run ./backend/cmd/server",
    "check": "node --check frontend/app.js",
    "openclaw": "openclaw",
    "openclaw:smoke": "python ./experiments/asb/openclaw/run_openclaw_cli.py --message \"Reply with exactly OK.\" --run-id openclaw-smoke-local --timeout 180 --fail-on-error"
  },
  "dependencies": {
    "openclaw": "2026.4.20-beta.1"
  }
}
